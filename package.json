{
	"name": "vite-react-cdn",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"format": "oxfmt",
		"check": "oxlint . && oxfmt",
		"trivy:check": "trivy fs . && trivy config .",
		"trivy:license": "trivy fs --scanners license --severity HIGH,CRITICAL .",
		"license": "license-checker --csv | awk -F, 'BEGIN {OFS=\",\"} {temp=$2; $2=$3; $3=temp; print}' > tmp-license.csv"
	},
	"dependencies": {
		"cowsay": "^1.6.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@tomjs/vite-plugin-html": "^1.5.2",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react-swc": "^3.11.0",
		"typescript": "^5.9.3",
		"vite": "^5.4.21"
	}
}
